name: diag-controle

on:
  schedule:
    - cron: '20 20 * * *'
  workflow_dispatch:

permissions: {}

jobs:
  registrar:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: evidencia
        run: |
          {
            echo "### controle (UTC puro)"
            echo "- evento: ${{ github.event_name }}"
            echo "- cron: ${{ github.event.schedule || 'n/a' }}"
            echo "- esperado: 20:20 UTC"
            echo "- real UTC: $(date -u +%FT%TZ)"
            echo "- real Recife: $(TZ=America/Recife date +%FT%T)"
          } >> "$GITHUB_STEP_SUMMARY"